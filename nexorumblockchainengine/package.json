{
  "name": "nexorum-blockchain-engine",
  "private": true,
  "version": "1.0.0",
  "description": "NEXORUM OS Blockchain Engine — Modular multi-chain plugin architecture with Cloudflare Workers support",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:worker": "wrangler dev src/worker.ts --port 3000",
    "compile:contracts": "node scripts/compileContracts.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute nexorum-db --local --file=./src/core/db/schema.sql",
    "db:migrate:prod": "wrangler d1 execute nexorum-db --remote --file=./src/core/db/schema.sql"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "solc": "^0.8.36",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^3.101.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "solana",
    "cloudflare-workers",
    "d1",
    "web3",
    "nexorum"
  ],
  "author": "NEXORUM OS",
  "license": "MIT"
}
